<?xml version="1.0" encoding="utf-8"?>
<com.sonymobile.cameracommon.view.SelfTimerCountDownView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="top"
        android:id="@+id/selftimer_countdown_layout_base_landscape"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_gravity="top"
            android:orientation="vertical"
            android:id="@+id/selftimer_countdown_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:layout_gravity="center"
                android:layout_width="match_parent"
                android:layout_height="56dp">
                <TextView
                    android:textSize="16dp"
                    android:textColor="#ffffffff"
                    android:layout_gravity="center"
                    android:id="@+id/selftimer_hint_text"
                    android:visibility="invisible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="16dp"
                    android:text="@string/cam_strings_self_timer_hint_countdown_txt"
                    android:maxLines="1"
                    android:layout_above="@+id/selftimer_countdown_base"
                    android:lineSpacingMultiplier="1.2"
                    android:fontFamily="sans-serif-medium"
                    style="@style/SelfTimerTextDropShadow"/>
            </FrameLayout>
            <FrameLayout
                android:layout_gravity="center"
                android:id="@+id/selftimer_countdown_base"
                android:layout_width="120dp"
                android:layout_height="120dp">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/selftimer_countdown_bg"
                    android:layout_width="@dimen/viewfinder_countdown_outside_diameter"
                    android:layout_height="@dimen/viewfinder_countdown_outside_diameter"
                    android:src="@drawable/selftimer_countdown_bg"/>
                <com.sonymobile.cameracommon.view.SelfTimerCountDownCircleView
                    android:layout_gravity="center"
                    android:id="@+id/selftimer_countdown_circle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <com.sonymobile.cameracommon.view.SelfTimerCountDownNumberView
                    android:layout_gravity="center"
                    android:id="@+id/selftimer_countdown_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:shadowColor="#00000000"
                    style="@style/OnScreenTextDropShadow"/>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/selftimer_countdown_layout_base_port"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:id="@+id/selftimer_countdown_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <FrameLayout
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_above="@+id/selftimer_countdown_base"
                android:layout_alignParentRight="true"
                android:layout_centerInParent="true">
                <TextView
                    android:textSize="16dp"
                    android:textColor="#ffffffff"
                    android:gravity="center"
                    android:id="@+id/selftimer_hint_text_port"
                    android:visibility="invisible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="96dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginBottom="24dp"
                    android:text="@string/cam_strings_self_timer_hint_countdown_txt"
                    android:maxLines="4"
                    android:lineSpacingMultiplier="1.2"
                    android:fontFamily="sans-serif-medium"
                    style="@style/SelfTimerTextDropShadow"/>
            </FrameLayout>
            <FrameLayout
                android:layout_gravity="center"
                android:id="@+id/selftimer_countdown_base"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginRight="24dp"
                android:layout_alignParentRight="true"
                android:layout_centerInParent="true">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/selftimer_countdown_bg"
                    android:layout_width="@dimen/viewfinder_countdown_outside_diameter"
                    android:layout_height="@dimen/viewfinder_countdown_outside_diameter"
                    android:src="@drawable/selftimer_countdown_bg"/>
                <com.sonymobile.cameracommon.view.SelfTimerCountDownCircleView
                    android:layout_gravity="center"
                    android:id="@+id/selftimer_countdown_circle_port"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <com.sonymobile.cameracommon.view.SelfTimerCountDownNumberView
                    android:layout_gravity="center"
                    android:id="@+id/selftimer_countdown_text_port"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:shadowColor="#00000000"
                    style="@style/OnScreenTextDropShadow"/>
            </FrameLayout>
        </RelativeLayout>
    </LinearLayout>
</com.sonymobile.cameracommon.view.SelfTimerCountDownView>
