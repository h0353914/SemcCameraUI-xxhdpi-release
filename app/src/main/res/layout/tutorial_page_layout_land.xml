<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/tutorial_title_text_size"
        android:textColor="@color/tutorial_title_text_color"
        android:id="@+id/tutorial_page_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="28dp"
        android:layout_marginRight="24dp"
        android:layout_marginBottom="16dp"
        android:text=""
        android:maxLines="2"
        android:layout_toRightOf="@+id/tutorial_page_icon"
        android:contentDescription=""
        android:fontFamily="sans-serif-regular"/>
    <TextView
        android:textSize="@dimen/tutorial_text_size"
        android:textColor="@color/tutorial_text_color"
        android:id="@+id/tutorial_page_description"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="24dp"
        android:layout_marginBottom="64dp"
        android:text="@string/cam_strings_tutorial_txt"
        android:layout_toRightOf="@+id/tutorial_page_icon"
        android:layout_below="@+id/tutorial_page_title"
        android:lineSpacingMultiplier="1.4"
        android:contentDescription="@string/cam_strings_tutorial_txt"
        android:fontFamily="sans-serif-regular"/>
</RelativeLayout>
