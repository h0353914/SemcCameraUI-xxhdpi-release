<?xml version="1.0" encoding="utf-8"?>
<com.sonyericsson.cameracommon.rotatableview.RotatableTextViewInLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rotatable_text_view_layout"
    android:focusable="false"
    android:focusableInTouchMode="false"
    android:clickable="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/rotatable_text_view_background"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <TextView
        android:id="@+id/rotatable_text_view_text"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/OnScreenTextDropShadow"/>
</com.sonyericsson.cameracommon.rotatableview.RotatableTextViewInLayout>
