<?xml version="1.0" encoding="utf-8"?>
<com.sonyericsson.android.camera.view.tutorial.PagingTutorialContentView xmlns:android="http://schemas.android.com/apk/res/android"
    android:focusable="false"
    android:focusableInTouchMode="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/tutorial_page_icon"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"/>
        <com.sonyericsson.android.camera.view.tutorial.TutorialVideoView
            android:id="@+id/tutorial_page_video"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"/>
        <com.duolingo.open.rtlviewpager.RtlViewPager
            android:id="@+id/tutorial_view_pager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:importantForAccessibility="no"/>
        <FrameLayout
            android:id="@+id/tutorial_paging_navigator_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="10dp"
            android:layout_alignParentBottom="true"/>
    </LinearLayout>
</com.sonyericsson.android.camera.view.tutorial.PagingTutorialContentView>
