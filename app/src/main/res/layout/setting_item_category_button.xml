<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/background"
        android:background="@drawable/setting_item_selector"
        android:paddingLeft="@dimen/left_edge_padding"
        android:paddingRight="@dimen/right_edge_padding"
        android:paddingBottom="0dp"
        android:layout_width="match_parent"
        android:layout_height="@dimen/menu_dialog_item_height">
        <LinearLayout
            android:layout_gravity="start|center_vertical"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:gravity="start|center_vertical"
                android:layout_gravity="start"
                android:id="@+id/category"
                android:paddingBottom="@dimen/left_mid_padding"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:maxWidth="@dimen/setting_item_text_width"
                android:maxLines="1"
                style="@style/TextAppearance.SomcCamera.Large"/>
            <TextView
                android:gravity="start|center_vertical"
                android:layout_gravity="start"
                android:id="@+id/value"
                android:paddingTop="0dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="@dimen/setting_item_text_width"
                android:maxLines="1"
                style="@style/TextAppearance.SomcCamera.Medium"/>
        </LinearLayout>
    </FrameLayout>
    <RelativeLayout
        android:id="@+id/setting_divider"
        android:background="@drawable/cam_dialog_separator_icn"
        android:paddingLeft="@dimen/divider_side_padding"
        android:paddingRight="@dimen/divider_side_padding"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider_height"/>
</LinearLayout>
