<?xml version="1.0" encoding="utf-8"?>
<com.sonyericsson.cameracommon.focusview.TaggedRectangle xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/af_rectangle"
    android:focusable="false"
    android:focusableInTouchMode="false"
    android:visibility="invisible"
    android:clickable="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.sonyericsson.cameracommon.focusview.Rectangle
        android:id="@+id/rect"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/rect_image"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"/>
    </com.sonyericsson.cameracommon.focusview.Rectangle>
</com.sonyericsson.cameracommon.focusview.TaggedRectangle>
