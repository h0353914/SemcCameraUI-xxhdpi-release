<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_gravity="right"
        android:id="@+id/capturing_button_container"
        android:paddingTop="@dimen/right_icon_area_top_mergin"
        android:paddingBottom="@dimen/right_icon_area_bottom_mergin"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layoutDirection="ltr">
        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/preloaded_capture_button_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <include layout="@layout/baselayout_on_screen_button_group"/>
        </FrameLayout>
    </FrameLayout>
</FrameLayout>
