<?xml version="1.0" encoding="utf-8"?>
<com.sonyericsson.cameracommon.rotatableview.RotatableContainerView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/container"
        android:layout_width="0dp"
        android:layout_height="0dp">
        <FrameLayout
            android:gravity="top"
            android:layout_gravity="center"
            android:id="@+id/overlay"
            android:layout_width="0dp"
            android:layout_height="0dp"/>
    </FrameLayout>
</com.sonyericsson.cameracommon.rotatableview.RotatableContainerView>
