<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/preview_container_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">
    <FrameLayout
        android:id="@+id/preview_container"
        android:padding="0dp"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_margin="0dp"/>
    <FrameLayout
        android:id="@+id/preview_container_fill"
        android:background="@drawable/cam_viewfinder_4_3_background_icn"
        android:padding="0dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="0dp"
        android:layout_toRightOf="@+id/preview_container"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:layout_gravity="left"
            android:id="@+id/preview_overlay_container"
            android:padding="0dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="0dp"/>
        <include layout="@layout/viewfinder_recording_indicator"/>
    </FrameLayout>
</RelativeLayout>
